# HTTP transport config for remote MCP (Dokploy)
PORT=3000
MCP_PATH=/mcp

# Long random secret. Generate: openssl rand -hex 32
# Doubles as: (1) Bearer token for mcp-remote bridge, (2) login password on the OAuth consent page
MCP_AUTH_TOKEN=changeme

# Public base URL of this server (used for OAuth metadata/redirects). No trailing slash.
# If unset, derived from X-Forwarded-Proto/Host headers (works behind a reverse proxy like Traefik).
PUBLIC_URL=https://mcp.example.com

# Kill switch - set to false to disable the server without removing the container
MCP_ENABLED=true

# SSH connections - two formats. If SSH_CONNECTIONS (A) is set it wins; otherwise B is used.

# Format A (JSON, one var):
# SSH_CONNECTIONS={"web1":{"host":"1.2.3.4","port":22,"username":"root","password":"secret"}}

# Format B (per-server vars, human-friendly, no escaping). ID = middle part, lowercased.
# Use _PASSWORD or _KEY_B64 (key file base64-encoded via tools/key2env.ps1). _PORT defaults to 22.
SSH_WEB1_HOST=1.2.3.4
SSH_WEB1_PORT=22
SSH_WEB1_USER=root
SSH_WEB1_PASSWORD=secret
# SSH_DB1_HOST=5.6.7.8
# SSH_DB1_USER=root
# SSH_DB1_KEY_B64=LS0tLS1CRUdJTiBP...
# SSH_DB1_PASSPHRASE=optional

# Optional command timeout in seconds (default 60)
# SSH_TIMEOUT=60

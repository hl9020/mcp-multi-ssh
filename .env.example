# HTTP transport config for remote MCP (Dokploy)
PORT=3000
MCP_PATH=/mcp

# Long random secret. Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=changeme

# Kill switch - set to false to disable the server without removing the container
MCP_ENABLED=true

# SSH connections as JSON. privateKey accepts the key content directly (\n escaped).
# Password auth example:
SSH_CONNECTIONS={"srv01":{"host":"1.2.3.4","port":22,"username":"root","password":"secret"}}

# Key auth example (escape newlines as \n):
# SSH_CONNECTIONS={"srv01":{"host":"1.2.3.4","port":22,"username":"root","privateKey":"-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"}}

# Optional command timeout in seconds (default 60)
# SSH_TIMEOUT=60
